  "author": "NativeDog1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NativeDog1/doubao-boot-animation.git"
  },
  "homepage": "https://github.com/NativeDog1/doubao-boot-animation#readme",
  "bugs": {
    "url": "https://github.com/NativeDog1/doubao-boot-animation/issues"
  }
}
